@page "/greetingApp"
@using Microsoft.Extensions.Localization
@layout EmptyLayout

@inject NavigationManager navManager
@inject IStringLocalizer<Shared> localizer

<h3>Localization Demo</h3>

<button @onclick="English">
    English
</button>

<button @onclick="Tamil">
    Tamil
</button>


<hr />

<h4>@localizer["Welcome"]</h4>

@code {

    private void English()
    {
        navManager.NavigateTo(
            "/Culture/Set?culture=en-US",
            true);
    }

    private void Tamil()
    {
        navManager.NavigateTo(
            "/Culture/Set?culture=ta-IN",
            true);
    }

  
}